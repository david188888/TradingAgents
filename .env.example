# LLM Providers (set the one you use)
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
DASHSCOPE_CN_API_KEY=
ZHIPU_API_KEY=
ZHIPU_CN_API_KEY=
MINIMAX_API_KEY=
MINIMAX_CN_API_KEY=
OPENROUTER_API_KEY=

# FRED (Federal Reserve macro data: rates, inflation, labor, growth). Free key: https://fred.stlouisfed.org/docs/api/api_key.html
#FRED_API_KEY=

# Native A-share research uses bounded public sources with Tushare backup.
# The official SZSE calendar serves all A-share exchanges, with Tencent/TDX
# witnesses; Tushare is the last calendar fallback and supplies valuation history.
# Missing credentials/entitlement leave those optional Tushare paths unavailable.
# Get a token from https://tushare.pro/. AKShare needs no key and belongs to
# optional data-provider adapters, not the V9 default collector.
#TUSHARE_TOKEN=
#TUSHARE_API_KEY=

# Wind AIFin Market (https://aifinmarket.wind.com.cn) - premium A-share index,
# macro EDB, risk metrics, fundamentals and document retrieval. Obtain a key
# from the developer portal; keep it out of logs and fixtures. The retained
# vendor path defaults wind_enabled to true, but needs the CLI and key.
# V9 evidence research does not use Wind. Disable optional Wind capabilities with:
#TRADINGAGENTS_WIND_ENABLED=false
#WIND_API_KEY=

# Tavily: V9 dual search for news/industry and missing-field discovery.
# DeepSeek standalone Search/Fetch uses DEEPSEEK_API_KEY above, independently of the research model.
# Disable independent Search/Fetch for new runs; research model calls stay enabled.
#TRADINGAGENTS_EVIDENCE_SEARCH_ENABLED=false
# Optional news/global-news adapters also use Tavily when configured.
# Free key: https://tavily.com/
#TAVILY_API_KEY=
# Optional round-robin key pool.  429/5xx/network health is tracked per key;
# 401/403 is reported explicitly and never bypassed by rotating credentials.
#TAVILY_API_KEYS=

# Doubao (豆包搜索 Global 版) web search - Volcengine/ByteDance search API.
# Key from: https://console.volcengine.com/ark (联网搜索控制台 - API Key 管理)
# Free tier: 500 calls/month per Volcengine account; no server-side date filter.
#DOUBAO_SEARCH_API_KEY=
#DOUBAO_SEARCH_API_KEYS=

# Bocha (博查) web search - domestic Bing-compatible search API.
# Key from: https://open.bocha.cn (paid per query; see their pricing page)
#BOCHA_API_KEY=
#BOCHA_API_KEYS=first-key,second-key

# Optional: point at a remote Ollama server. When unset, defaults to
# the local instance at http://localhost:11434/v1. Convention follows
# the broader Ollama ecosystem; the model client picks this up.
#OLLAMA_BASE_URL=http://your-ollama-host:11434/v1

# Optional: override DEFAULT_CONFIG without editing code.
# Any TRADINGAGENTS_* variable below, when set, replaces the matching key
# in tradingagents/default_config.py. Values are coerced to the type of
# the existing default (bool / int / str), so "true"/"3" work as expected.
# CLI flags and local JSON override these defaults.
#TRADINGAGENTS_LLM_PROVIDER=openai
#TRADINGAGENTS_DEEP_THINK_LLM=gpt-5.4
#TRADINGAGENTS_QUICK_THINK_LLM=gpt-5.4-mini
#TRADINGAGENTS_LLM_BACKEND_URL=
#TRADINGAGENTS_OUTPUT_LANGUAGE=English

# Native Web creation is enabled by default. false blocks new single/batch
# runs and fresh retries, while retaining saved reads and compatible recovery.
#TRADINGAGENTS_EVIDENCE_ENABLED=true

#TRADINGAGENTS_HALT_ON_MISSING_DATA=true
# Sampling temperature (lower = less run-to-run variation on models that
# honor it). Unset leaves each provider at its default. No setting makes LLM
# output fully deterministic; DeepSeek thinking mode omits temperature.
#TRADINGAGENTS_TEMPERATURE=0.0
# Model-client SDK retry setting. V9 research overrides it with zero SDK
# retries and uses its durable attempt budgets.
#TRADINGAGENTS_LLM_MAX_RETRIES=6
# Provider-specific reasoning/thinking depth. Unset retains the fork defaults
# in default_config.py.
#TRADINGAGENTS_OPENAI_REASONING_EFFORT=medium
#TRADINGAGENTS_GOOGLE_THINKING_LEVEL=high
#TRADINGAGENTS_ANTHROPIC_EFFORT=high
# DeepSeek thinking mode (default enabled with high effort). While enabled,
# the API ignores temperature/top_p, tool_choice
# is unsupported, and the client echoes reasoning_content back on the next
# turn. Set disabled to use the non-thinking path (tool_choice + temperature).
# Effort accepts low/medium/high/xhigh/max (medium/xhigh map to high).
#TRADINGAGENTS_DEEPSEEK_THINKING=enabled
#TRADINGAGENTS_DEEPSEEK_REASONING_EFFORT=high
# Optional output-token ceiling (including Gemini's max_output_tokens).
# Unset leaves the provider ceiling in effect; it is not a report-length target.
# See docs/operations/llm-reasoning.md for supported controls and recovery.
#TRADINGAGENTS_LLM_MAX_TOKENS=16384
