  "calendar_probe_source": "import json\nfrom tradingagents.dataflows.native_qualification import qualify_session_calendar,CALENDAR_INDEX_SYMBOL,NativeSourceUnavailable\nfrom tradingagents.dataflows.tushare_price_history import settled_sessions\nfrom datetime import datetime\n\ndef probe(label,bars,cutoff,capture):\n    payload={'data':{CALENDAR_INDEX_SYMBOL:{'day':[[day,'1','1','1','1','1'] for day in bars]}}}\n    try:\n        rows=qualify_session_calendar(payload,index_symbol=CALENDAR_INDEX_SYMBOL,start='2026-10-15',cutoff=cutoff)\n        result={'admitted':True,'rows':rows,'settled':settled_sessions(rows,start='2026-10-15',cutoff=cutoff,captured_at=datetime.fromisoformat(capture))}\n    except NativeSourceUnavailable as e:result={'admitted':False,'code':e.code}\n    return {'case':label,**result}\nresults=[probe('weekend cutoff with full preceding weekday bars',['2026-10-15','2026-10-16'],'2026-10-18','2026-10-18T12:00:00+08:00'),probe('Monday before market open',['2026-10-15','2026-10-16'],'2026-10-19','2026-10-19T00:08:00+08:00'),probe('internal weekday bar missing but boundaries present',['2026-10-15','2026-10-19'],'2026-10-19','2026-10-19T16:00:00+08:00')]\nprint(json.dumps(results,ensure_ascii=False,indent=2))\n",
